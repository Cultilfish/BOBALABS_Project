# --- LLM ---------------------------------------------------------------
# gemini | anthropic | openai (any OpenAI-compatible API, e.g. Groq) | fake
LLM_PROVIDER=gemini
# Production uses gemini-3.5-flash-lite (fast, separate free quota). Run scripts/check_llm.py to see
# which models your key can use. Empty = defaults: gemini-3.5-flash / claude-haiku-4-5 / llama-3.3-70b-versatile
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Space out calls to stay under free-tier rate limits (seconds). 0 = off.
LLM_MIN_INTERVAL_SECONDS=0
# Gemini 'thinking' depth: low / minimal makes replies much faster. Empty = model default.
GEMINI_THINKING_LEVEL=low
# Per-call timeout and attempts (keep timeout x retries under the gunicorn timeout of 180 s)
LLM_TIMEOUT_SECONDS=45
LLM_RETRIES=2

# --- Prompt database ---------------------------------------------------
# Leave both empty to use a local SQLite file (prompts.db) instead.
SUPABASE_URL=https://your-project.supabase.co
# Settings > API Keys > Secret key (sb_secret_...). Legacy service_role key also works.
SUPABASE_KEY=sb_secret_your-key

# --- Access control ----------------------------------------------------
# Required in the X-Admin-Token header for POST /prompt/rollback when set.
ADMIN_TOKEN=change-me
# true = /improve-ai and /improve-ai-manually also need the admin token.
PROTECT_EDIT_ENDPOINTS=false
